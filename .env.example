APP_NAME="Clinique Saint Georges"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rivo_clinic
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =========================================================
# RIVO - CURRENT DEPLOYMENT IDENTITY
# =========================================================
#
# Every deployment of this codebase must set these three. They are read
# once, centrally, through config('rivo.site.*') — never env() scattered
# around the app — so nothing here can drift from what config/rivo.php
# actually exposes. `type` decides which routes exist (see EnsureSiteType
# middleware): clinic | admin | gateway. Unset/unrecognised falls back to
# "clinic", the most tested path, so a plain checkout never accidentally
# behaves like the staff gateway or the admin portal.
#
# "gateway" is app.rivo.mg — the staff entry point that lets someone pick
# which clinic to log into. It is a deployment of THIS codebase. It is NOT
# cliniquesaintgeorges.mg, the public marketing site — that domain is a
# separate concern and nothing here renders anything for it.
#
# APP_URL (Laravel's own config) must also be set to this deployment's
# real URL — RIVO_SITE_CODE/NAME/TYPE describe *who* it is, APP_URL is
# *where* it is, no need to duplicate the URL under a RIVO_ var too.

RIVO_SITE_CODE=
RIVO_SITE_NAME=
RIVO_SITE_TYPE=clinic

# Example Mampikony:
# RIVO_SITE_CODE=M
# RIVO_SITE_NAME=Mampikony
# RIVO_SITE_TYPE=clinic
# APP_URL=https://clinique-m.rivo.mg

# Example Ambondromamy:
# RIVO_SITE_CODE=A
# RIVO_SITE_NAME=Ambondromamy
# RIVO_SITE_TYPE=clinic
# APP_URL=https://clinique-a.rivo.mg

# Example Boriziny:
# RIVO_SITE_CODE=B
# RIVO_SITE_NAME=Boriziny
# RIVO_SITE_TYPE=clinic
# APP_URL=https://clinique-b.rivo.mg

# Example Super Administration — brand text stays "Clinique Saint Georges"
# (config('rivo.brand')); RIVO_SITE_NAME is the second header line only:
# RIVO_SITE_CODE=ADMIN
# RIVO_SITE_NAME="Super Administration"
# RIVO_SITE_TYPE=admin
# APP_URL=https://admin.rivo.mg

# Example staff gateway (app.rivo.mg) — "choose your site" entry point.
# No RIVO_SITE_CODE/NAME needed, it doesn't operate as a specific clinic.
# Not the public marketing site — see note above.
# RIVO_SITE_TYPE=gateway
# APP_URL=https://app.rivo.mg


# =========================================================
# RIVO - INTER-SITE
# =========================================================
#
# Peer topology with 3 clinic sites (M/A/B) is not decided yet — each site
# currently assumes a single peer, which no longer holds with three. Left
# unset until that's resolved; do not guess a topology here.

RIVO_PEER_SITE_URL=

# Mampikony (topology TBD once Boriziny is wired in):
# RIVO_PEER_SITE_URL=https://clinique-a.rivo.mg

# Ambondromamy (topology TBD once Boriziny is wired in):
# RIVO_PEER_SITE_URL=https://clinique-m.rivo.mg


# =========================================================
# RIVO - CENTRAL SERVICES
# =========================================================

RIVO_ADMIN_URL=https://admin.rivo.mg
RIVO_PUBLIC_URL=https://cliniquesaintgeorges.mg

# The staff gateway itself (app.rivo.mg) — every clinic/admin deployment
# needs this to link back to it ("choose another site" on the login page).
RIVO_GATEWAY_URL=https://app.rivo.mg


# =========================================================
# RIVO - CLINIC DIRECTORY (staff gateway only, app.rivo.mg)
# =========================================================
#
# Only the staff gateway (RIVO_SITE_TYPE=gateway) reads these, to build the
# "choose your site" redirect links. A clinic or admin deployment does not
# use them. Defaults already match the real subdomains — only override for
# local/staging.

# RIVO_SITE_MAMPIKONY_URL=https://clinique-m.rivo.mg
# RIVO_SITE_AMBONDROMAMY_URL=https://clinique-a.rivo.mg
# RIVO_SITE_BORIZINY_URL=https://clinique-b.rivo.mg
